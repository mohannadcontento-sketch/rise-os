# ==================== RiseOS Environment Variables ====================

# ─── OPTION 1: Local SQLite (default — works out of the box) ───
# No Supabase needed. The app runs with a local SQLite database.
DATABASE_URL=file:./db/riseos.db

# ─── OPTION 2: Supabase (for production / multi-user) ───
# Set these on Vercel (Project Settings → Environment Variables).
# Then run supabase/migrations/005_phase1_security_fixes.sql in Supabase SQL Editor.
#
 NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
 NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
 SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# ⚠️ SECURITY: Never commit real keys. The service role key bypasses RLS —
# keep it only in Vercel/supabase env settings. If it was ever leaked, rotate it
# in Supabase Dashboard → Settings → API.
# ─── Optional: Admin email (for admin panel access) ───
# ADMIN_EMAIL=your-email@example.com

# ─── Optional: AI Coach (ZhipuAI / BigModel) ───
# BIGMODEL_API_KEY=your-api-key

# ==================== Phase 1 Security Notes ====================
# After setting Supabase env vars, run these migrations in order:
# 1. supabase/migrations/004_full_fix.sql (base schema)
# 2. supabase/migrations/005_phase1_security_fixes.sql (P1 security fixes)
#
# Security features enabled in Phase 1:
# - Cookie-based auth (httpOnly + Secure + SameSite) — P1#3
# - Rate limiting (5 auth/min, 20 AI/hr, 100 API/min) — P1#6
# - CSP + HSTS + X-Frame-Options headers — P1#10
# - Zod validation on finance/focus/notifications — P1#5
# - API keys hashed with SHA-256 — P1#7
# - RLS bypass fixed (per-user client) — P1#1
# - RLS infinite recursion fixed — P1#2
# - Composite indexes for performance — P1#8
# - Password minimum 8 characters — P1#11
