# ==================== RiseOS Environment Variables ====================

# ─── OPTION 1: Local SQLite (default — works out of the box) ───
# Optional: stable signing secret for local mock-auth sessions. Without it, a random per-process secret is used.
# MOCK_AUTH_SECRET=generate-a-long-random-value-for-local-testing

# No Supabase needed. The app runs with a local SQLite database.
DATABASE_URL=file:./db/riseos.db

# ─── OPTION 2: Supabase (for production / multi-user) ───
# Set these on Vercel (Project Settings → Environment Variables).
# Then run supabase/migrations/005_phase1_security_fixes.sql in Supabase SQL Editor.
#
 NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
 NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
 SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# ⚠️ SECURITY: Never commit real keys. The service role key bypasses RLS —
# keep it only in Vercel/supabase env settings. If it was ever leaked, rotate it
# in Supabase Dashboard → Settings → API.
# ─── Optional: Admin email (for admin panel access) ───
# ADMIN_EMAIL=your-email@example.com
# ─── Optional: extra trusted origins for browser CSRF protection ───
# ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# ==================== Phase 1 Security Notes ====================
# After setting Supabase env vars, run these migrations in order:
# 1. supabase/migrations/004_full_fix.sql (base schema)
# 2. supabase/migrations/005_phase1_security_fixes.sql (P1 security fixes)
# 3. supabase/migrations/012_admin_pro.sql (account suspension)
# 4. supabase/migrations/013_security_hardening.sql (hashed API keys + audit ledger)
#
# Security features enabled in Phase 1:
# - Cookie-based auth (httpOnly + Secure + SameSite) — P1#3
# - Rate limiting (5 auth/min, 20 AI/hr, 100 API/min) — P1#6
# - CSP + HSTS + X-Frame-Options headers — P1#10
# - Zod validation on finance/focus/notifications — P1#5
# - API keys stored as SHA-256 hashes — P1#7
# - RLS bypass fixed (per-user client) — P1#1
# - RLS infinite recursion fixed — P1#2
# - Composite indexes for performance — P1#8
# - Password minimum 8 characters — P1#11

# ─── Phase 4: وسائل الدفع اليدوي (تظهر في تعليمات الترقية) ───
# اضبطها في Vercel دون نشر جديد — تعليمات «ترقية الخطة» في الإعدادات تقرؤها.
# PAYMENT_INSTAPAY=name@instapay
# PAYMENT_VODAFONE_CASH=01012345678
# PAYMENT_ETISALAT_CASH=01112345678

# ─── Phase 6: Web Push (VAPID) ────────────────────────────────
# اختيارية بالكامل — المفاتيح مزروعة أصلًا في جدول app_config
# بالـSupabase (زرعها Super-Z في الهجرة 028؛ قراءة service_role
# فقط). لو وضعتها هنا (Vercel env) فستُستخدم بدل قاعدة البيانات.
# لتوليد زوج جديد: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:awj@awj.life

# ── Phase 07-ب: تخزين الصور (Cloudinary — بديل R2) ───────────
# قرار المالك (سبتمبر 2026): الصور والمرفقات على Cloudinary —
# CDN عالمي + تحويلات f_auto/q_auto، ولا تخزين صور في Supabase.
# القيم الثلاث من Cloudinary Dashboard → Account Details /
# (أو Settings → API Keys):
#   CLOUDINARY_CLOUD_NAME  = اسم الـ cloud (يظهر أعلى الداشبورد)
#   CLOUDINARY_API_KEY     = المفتاح العام
#   CLOUDINARY_API_SECRET  = المفتاح السري (لا يُعرض إلا مرة)
# ملاحظة: ترك هذه المتغيرات فارغة يعني أن الصور غير مفعّلة —
# لكن يمكن أيضًا زرع القيم في جدول app_config عبر service_role
# (نفس نمط VAPID) وقد زرع Super-Z قيم Turso هناك بالفعل.
# بدون هذه المفاتيح: المجتمع يعمل نصيًا كاملًا، وزر الصور
# يعرض رسالة عربية واضحة (503 STORAGE_NOT_CONFIGURED).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Phase 07-ب: مرآة المجتمع (Turso) ────────────────────────
# قرار المالك (وثيقة النطاق §4): فصل مسار بيانات المجتمع العامة
# عن Supabase (تخفيف الضغط + عزل البيانات العامة).
# ✅ مفعّل بالفعل (Super-Z، 12 سبتمبر 2026): قاعدة awj-community
# على org mohaned52 (aws-eu-west-1) + token كامل الصلاحية —
# القيم مزروعة في app_config (قراءة service_role فقط) وتعمل
# بلا أي إعداد هنا؛ هذه المتغيرات تتجاوزها إذا حُددت.
# كل كتابة مجتمع تنجح أولًا في Supabase (مصدر الحقيقة) ثم تُعكس
# إلى Turso تلقائيًا (fire-and-forget) + التعبئة الأولية تمت.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# لاحقًا فقط وبعد التحقق من المزامنة — قراءة الخلاصة من Turso:
# TURSO_READ_MODE=false

# ── Phase 10-ب: Supabase Edge Functions (MCP + مرسل البوش) ──
# وظيفتان Deno تعيشان على Supabase نفسها (supabase/functions/):
#   • mcp           — خادم MCP كامل (نفس أدوات مسار Vercel الثمانية)
#   • push-dispatch — مكنسة طابور Web Push كل دقيقتين (pg_cron)
# النشر من الطرفية (مرة واحدة + عند أي تعديل — ملاحظة --no-verify-jwt
# إلزامية لأن مفاتيح rise_ ليست Supabase JWT):
#   supabase login
#   supabase link --project-ref <PROJECT_REF>
#   supabase functions deploy mcp --no-verify-jwt
#   supabase functions deploy push-dispatch --no-verify-jwt
# ثم شغّل الهجرة supabase/migrations/033_phase10b_edge_functions.sql
# في SQL Editor (idempotent) — وخطوات تفعيل الجدولة موثقة آخرها.
# الاختبار المحلي (بلا Supabase): deno test --allow-net \
#   --allow-run --allow-read --allow-env \
#   --config supabase/functions/deno.json supabase/tests/edge/
# اختباري CRON_SECRET اختياري (بديل مصادقة المجدول لمفتاح الخدمة):
# CRON_SECRET=
